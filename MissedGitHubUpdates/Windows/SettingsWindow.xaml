<Window x:Class="MissedGitHubUpdates.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Missed GitHub Updates"
        Height="340" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Input box style -->
        <Style x:Key="InputBox" TargetType="Control">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#24292F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- PAT label -->
            <RowDefinition Height="Auto"/>  <!-- PAT input -->
            <RowDefinition Height="12"/>    <!-- spacer -->
            <RowDefinition Height="Auto"/>  <!-- Username label -->
            <RowDefinition Height="Auto"/>  <!-- Username input -->
            <RowDefinition Height="12"/>    <!-- spacer -->
            <RowDefinition Height="Auto"/>  <!-- Interval label -->
            <RowDefinition Height="Auto"/>  <!-- Interval input -->
            <RowDefinition Height="16"/>    <!-- spacer -->
            <RowDefinition Height="Auto"/>  <!-- Buttons row -->
            <RowDefinition Height="12"/>    <!-- spacer -->
            <RowDefinition Height="Auto"/>  <!-- Status label -->
        </Grid.RowDefinitions>

        <!-- ── GitHub PAT ── -->
        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}"
                   Text="GitHub Personal Access Token"/>
        <PasswordBox x:Name="PATBox"
                     Grid.Row="1"
                     Style="{StaticResource InputBox}"
                     PasswordChar="●"
                     ToolTip="Generate at: GitHub → Settings → Developer settings → Personal access tokens"/>

        <!-- ── GitHub Username ── -->
        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}"
                   Text="GitHub Username"/>
        <TextBox x:Name="UsernameBox"
                 Grid.Row="4"
                 Style="{StaticResource InputBox}"
                 ToolTip="Your GitHub username (e.g. octocat)"/>

        <!-- ── Polling Interval ── -->
        <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}"
                   Text="Polling Interval (seconds)"/>
        <TextBox x:Name="IntervalBox"
                 Grid.Row="7"
                 Style="{StaticResource InputBox}"
                 Text="60"
                 Width="80"
                 HorizontalAlignment="Left"
                 ToolTip="How often to check GitHub for new events (minimum 30s)"/>

        <!-- ── Buttons ── -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestButton"
                    Style="{StaticResource SecondaryButton}"
                    Content="Test Connection"
                    Margin="0,0,8,0"
                    Click="TestButton_Click"/>
            <Button x:Name="SaveButton"
                    Style="{StaticResource PrimaryButton}"
                    Content="Save"
                    Click="SaveButton_Click"/>
        </StackPanel>

        <!-- ── Status feedback ── -->
        <TextBlock x:Name="StatusLabel"
                   Grid.Row="11"
                   FontSize="12"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Text=""/>
    </Grid>
</Window>
